{"kind": "tokens", "command": "rm -rf build", "tokens": ["w:rm", "w:-rf", "w:build"], "note": "plain words"}
{"kind": "tokens", "command": "r\\m -rf x", "tokens": ["w:rm", "w:-rf", "w:x"], "note": "an escaped command word becomes the plain word"}
{"kind": "tokens", "command": "\\git add -A", "tokens": ["w:git", "w:add", "w:-A"], "note": "alias-bypass backslash is removed"}
{"kind": "tokens", "command": "'rm' -rf x", "tokens": ["w:rm", "w:-rf", "w:x"], "note": "a quoted command word is the plain word"}
{"kind": "tokens", "command": "rm -rf \"$DIR\"", "tokens": ["w:rm", "w:-rf", "w:$DIR"], "note": "a double-quoted word without whitespace stays one word; the hook refuses the $"}
{"kind": "tokens", "command": "rm -rf a\\ b", "tokens": ["w:rm", "w:-rf", "w:a b"], "note": "an escaped space stays inside one word"}
{"kind": "tokens", "command": "rm -rf \\\nexamples", "tokens": ["w:rm", "w:-rf", "w:examples"], "note": "a line continuation is nothing"}
{"kind": "tokens", "command": "rm -rf node_modules 2>&1", "tokens": ["w:rm", "w:-rf", "w:node_modules"], "note": "a dup redirection and its fd number are dropped"}
{"kind": "tokens", "command": "rm -rf x > /dev/null", "tokens": ["w:rm", "w:-rf", "w:x"], "note": "a redirection operand is dropped, so it is never a target"}
{"kind": "tokens", "command": "echo hi # rm -rf x", "tokens": ["w:echo", "w:hi"], "note": "a comment is dropped to end of line"}
{"kind": "tokens", "command": "ls; rm -rf x", "tokens": ["w:ls", ";", "w:rm", "w:-rf", "w:x"], "note": "; separates"}
{"kind": "tokens", "command": "cd x && rm -rf y", "tokens": ["w:cd", "w:x", ";", "w:rm", "w:-rf", "w:y"], "note": "&& is a separator; runs of separators collapse"}
{"kind": "tokens", "command": "a | b", "tokens": ["w:a", ";", "w:b"], "note": "a pipe is a separator"}
{"kind": "tokens", "command": "{ rm -rf x; }", "tokens": ["w:rm", "w:-rf", "w:x", ";"], "note": "a standing-alone brace is a separator"}
{"kind": "tokens", "command": "rm -rf dist{,2}", "tokens": ["w:rm", "w:-rf", "w:dist{,2}"], "note": "a glued brace stays in the word, so brace expansion reaches the hook unresolved"}
{"kind": "tokens", "command": "echo ${VAR}", "tokens": ["w:echo", "w:${VAR}"], "note": "a glued ${...} stays in the word"}
{"kind": "tokens", "command": "find . -name x -exec rm -rf {} \\;", "tokens": ["w:find", "w:.", "w:-name", "w:x", "w:-exec", "w:rm", "w:-rf", ";", "w:;"], "note": "find's {} is a separator; the escaped ; is a plain word"}
{"kind": "tokens", "command": "sh -c \"rm -rf build\"", "tokens": ["w:sh", "w:-c", "q:rm -rf build"], "note": "a quoted string with whitespace is one q word, raw text kept for the nested scan"}
{"kind": "tokens", "command": "git commit -m \"add -A everything\"", "tokens": ["w:git", "w:commit", "w:-m", "q:add -A everything"], "note": "prose in a commit message is one q word"}
{"kind": "tokens", "command": "echo 'it is $(x)'", "tokens": ["w:echo", "q:it is $(x)"], "note": "single quotes are literal"}
{"kind": "tokens", "command": "x=$(git add -A)", "tokens": ["w:x=$", ";", "w:git", "w:add", "w:-A", ";"], "note": "parentheses are separators, so a command substitution is scanned as commands"}
{"kind": "tokens", "command": "x=`git push -f origin foo`", "tokens": ["w:x=", ";", "w:git", "w:push", "w:-f", "w:origin", "w:foo", ";"], "note": "backticks are separators"}
{"kind": "tokens", "command": "git push origin --delete \"$b\"", "tokens": ["w:git", "w:push", "w:origin", "w:--delete", "w:$b"], "note": "a variable ref stays an unresolvable word"}
{"kind": "texts", "command": "rm -rf build", "texts": ["0:rm -rf build\n"], "note": "one plain text"}
{"kind": "texts", "command": "sh -c 'rm -rf build'", "texts": ["0:sh -c 'rm -rf build'\n", "1:rm -rf build"], "note": "a quoted string handed to sh is queued for a nested scan"}
{"kind": "texts", "command": "eval \"git stash pop\"", "texts": ["0:eval \"git stash pop\"\n", "1:git stash pop"], "note": "eval runs its text"}
{"kind": "texts", "command": "ls | xargs -I{} sh -c 'rm -rf {}'", "texts": ["0:ls | xargs -I{} sh -c 'rm -rf {}'\n", "1:rm -rf {}"], "note": "xargs sh -c runs its text"}
{"kind": "texts", "command": "echo \"rm -rf x\"", "texts": ["0:echo \"rm -rf x\"\n"], "note": "echo prints: its quoted string is prose, not queued"}
{"kind": "texts", "command": "grep -rn \"rm -rf x\" .", "texts": ["0:grep -rn \"rm -rf x\" .\n"], "note": "grep takes a pattern: prose"}
{"kind": "texts", "command": "git commit -m \"block rm -rf x\"", "texts": ["0:git commit -m \"block rm -rf x\"\n"], "note": "a commit message is prose"}
{"kind": "texts", "command": "echo \"rm -rf x\" | sh", "texts": ["0:echo \"rm -rf x\" | sh\n", "1:rm -rf x"], "note": "piped into a shell, the prose is executed text"}
{"kind": "texts", "command": "mytool --run \"rm -rf x\"", "texts": ["0:mytool --run \"rm -rf x\"\n", "1:rm -rf x"], "note": "an unknown consumer is scanned like an executor"}
{"kind": "texts", "command": "cat <<EOF\nnever run rm -rf x\nEOF", "texts": ["0:cat  HEREDOC \n"], "note": "heredoc bodies are dropped before scanning"}
{"kind": "texts", "command": "git add foo.sh\ngit commit -F- <<'EOF'\nnever git add -A\nEOF", "texts": ["0:git add foo.sh\ngit commit -F-  HEREDOC \n"], "note": "a heredoc body that mentions a command is not that command"}
