#!/bin/sh
# A stand-in for gh: no test reaches the network. It logs its arguments to
# $LANGUETTE_STUB_LOG/gh and lists three open PRs whatever the filters (the
# hook's own select is what is under test). #1 is stacked on
# claude/base-branch, the head of #2; claude/lonely heads #3 and bases nothing.
# GH_FAIL makes it fail; GH_TAB puts a tab in a title, which the decision
# JSON must survive. For `api .../rules/branches/<b>` it answers GH_RULES: a
# pull_request rule when unset, "none" an empty list, "upgrade" the 403 a
# free private repo gets. For `api .../protection`, GH_PROTECTION "reviews"
# is protection with required reviews; unset is 404 "Branch not protected".
# For `api graphql ... id=<id>` it answers as GH_LOGIN with the review thread
# in $GH_THREADS/<id>.json, or GitHub's not-found error when there is none.
printf '%s\n' "$*" >> "${LANGUETTE_STUB_LOG:?}/gh"
[ -n "${GH_FAIL:-}" ] && exit 1
upgrade='{"message":"Upgrade to GitHub Pro or make this repository public to enable this feature.","status":"403"}'
case "$*" in
  api\ graphql*)
    id=$(printf '%s\n' "$@" | sed -n 's/^id=//p' | head -n 1)
    f="${GH_THREADS:-/nonexistent}/$id.json"
    if [ -n "$id" ] && [ -f "$f" ]; then
      printf '{"data":{"viewer":{"login":"%s"},"node":' "${GH_LOGIN:-me}"; cat "$f"; echo '}}'
      exit 0
    fi
    echo "{\"data\":{\"node\":null},\"errors\":[{\"type\":\"NOT_FOUND\",\"message\":\"Could not resolve to a node with the global id of '$id'\"}]}"
    exit 1 ;;
  api*/rules/branches/*)
    case "${GH_RULES:-pr}" in
      none) echo '[]' ;;
      upgrade) echo "$upgrade"; exit 1 ;;
      *) echo '[{"type":"deletion"},{"type":"pull_request","parameters":{}}]' ;;
    esac
    exit 0 ;;
  api*/protection)
    [ "${GH_PROTECTION:-}" = reviews ] && { echo '{"required_pull_request_reviews":{"required_approving_review_count":1}}'; exit 0; }
    echo '{"message":"Branch not protected","status":"404"}'; exit 1 ;;
esac
t="stacked change"; [ -n "${GH_TAB:-}" ] && t="stacked\\tchange"
cat <<JSON
[
 {"number":1,"title":"$t","baseRefName":"claude/base-branch","headRefName":"claude/stacked-one"},
 {"number":2,"title":"the base change","baseRefName":"main","headRefName":"claude/base-branch"},
 {"number":3,"title":"unrelated","baseRefName":"main","headRefName":"claude/lonely"}
]
JSON
